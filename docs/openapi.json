{
  "openapi": "3.1.0",
  "info": {
    "title": "Puente DeCA API",
    "version": "0.1.0",
    "description": "API-first bridge for Spanish electronic transport control documents (DeCA)."
  },
  "servers": [
    {
      "url": "https://deca.example.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Service is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/deca/validate": {
      "post": {
        "operationId": "validateDeca",
        "summary": "Validate and normalize DeCA data",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Valid payload"
          },
          "404": {
            "description": "Route is intentionally unavailable on the production engine surface"
          },
          "422": {
            "description": "Invalid payload"
          }
        }
      },
      "x-production-enabled": false,
      "x-purpose": "development-test-tool"
    },
    "/v1/deca/pdf": {
      "post": {
        "operationId": "renderDecaPdf",
        "summary": "Render an unstored native DeCA PDF",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecaRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Native PDF",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "contentEncoding": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Route is intentionally unavailable on the production engine surface"
          },
          "422": {
            "description": "Validation, character or QR capacity error"
          }
        }
      },
      "x-production-enabled": false,
      "x-purpose": "development-test-tool"
    },
    "/v1/shipments": {
      "post": {
        "operationId": "createShipment",
        "summary": "Create a tenant-scoped shipment",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent replay"
          },
          "201": {
            "description": "Shipment created"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Scope missing"
          },
          "409": {
            "description": "Idempotency conflict"
          },
          "422": {
            "description": "Invalid shipment data"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      },
      "get": {
        "operationId": "listShipments",
        "summary": "List tenant-scoped shipments",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shipment list"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Scope missing"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    },
    "/v1/shipments/{shipmentId}": {
      "get": {
        "operationId": "getShipment",
        "summary": "Get a shipment",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ShipmentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Shipment"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Scope missing"
          },
          "404": {
            "description": "Shipment not found"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      },
      "put": {
        "operationId": "updateShipment",
        "summary": "Update operational shipment data before regenerating DeCA",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ShipmentId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated shipment"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Scope missing"
          },
          "404": {
            "description": "Shipment not found"
          },
          "409": {
            "description": "External reference change rejected"
          },
          "422": {
            "description": "Invalid shipment data"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    },
    "/v1/shipments/{shipmentId}/deca": {
      "post": {
        "operationId": "generateShipmentDeca",
        "summary": "Generate, store and version a DeCA for a shipment",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ShipmentId"
          }
        ],
        "responses": {
          "201": {
            "description": "Stored DeCA document version"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Scope missing"
          },
          "404": {
            "description": "Shipment not found"
          },
          "422": {
            "description": "Document generation rejected"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    },
    "/v1/deca/{documentId}": {
      "get": {
        "operationId": "getDecaMetadata",
        "summary": "Get stored DeCA metadata",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DocumentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Stored document metadata"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Scope missing"
          },
          "404": {
            "description": "Document not found"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    },
    "/d/{token}.pdf": {
      "get": {
        "operationId": "downloadInspectionPdf",
        "summary": "Direct QR/inspection PDF download without login",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored native DeCA PDF",
            "headers": {
              "X-DeCA-Document-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "X-DeCA-Version": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "contentEncoding": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Document not found"
          },
          "500": {
            "description": "Stored artifact integrity failure"
          }
        }
      }
    },
    "/v1/credentials": {
      "get": {
        "operationId": "listConnectorCredentials",
        "summary": "List organization-scoped connector credentials",
        "security": [
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "responses": {
          "200": {
            "description": "Credential metadata list; secrets are never returned"
          },
          "401": {
            "description": "Kairoseth service authentication required"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      },
      "post": {
        "operationId": "createConnectorCredential",
        "summary": "Create an organization-scoped connector credential",
        "security": [
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "scopes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "shipments:read",
                        "shipments:write",
                        "documents:read",
                        "documents:write"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Credential created; apiKey is revealed once"
          },
          "401": {
            "description": "Kairoseth service authentication required"
          },
          "422": {
            "description": "Invalid name or scope"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    },
    "/v1/credentials/{credentialId}": {
      "delete": {
        "operationId": "revokeConnectorCredential",
        "summary": "Revoke an organization-scoped connector credential",
        "security": [
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "name": "credentialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Credential revoked"
          },
          "401": {
            "description": "Kairoseth service authentication required"
          },
          "404": {
            "description": "Credential not found"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Operational readiness",
        "responses": {
          "200": {
            "description": "Metadata and artifact storage are ready"
          },
          "503": {
            "description": "At least one operational dependency is unavailable"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getMetrics",
        "summary": "Protected low-cardinality process metrics",
        "security": [
          {
            "platformServiceSecret": []
          }
        ],
        "responses": {
          "200": {
            "description": "Prometheus-compatible process metrics",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Kairoseth service authentication required"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    },
    "/v1/usage/documents": {
      "get": {
        "operationId": "getOrganizationDocumentUsage",
        "summary": "Count tenant DeCA document versions inside a time window",
        "security": [
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Organization-scoped canonical DeCA document count"
          },
          "400": {
            "description": "Invalid or excessive usage window"
          },
          "401": {
            "description": "Kairoseth service authentication required"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    },
    "/v1/access/connectors": {
      "put": {
        "operationId": "setOrganizationConnectorAccess",
        "summary": "Set the organization connector-access lease",
        "security": [
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "validUntil"
                ],
                "properties": {
                  "validUntil": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connector access lease updated"
          },
          "401": {
            "description": "Kairoseth service authentication required"
          },
          "422": {
            "description": "Invalid connector access expiry"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Puente DeCA API key"
      },
      "platformServiceSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Kairoseth-Service-Secret",
        "description": "Server-to-server secret accepted only from Kairoseth Platform."
      },
      "platformOrganizationId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Kairoseth-Organization-Id",
        "description": "Canonical Kairoseth organization ID paired with platform service authentication."
      }
    },
    "parameters": {
      "ShipmentId": {
        "name": "shipmentId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "DocumentId": {
        "name": "documentId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string",
            "const": "puente-deca"
          }
        }
      },
      "Party": {
        "type": "object",
        "required": [
          "legalName",
          "taxId"
        ],
        "properties": {
          "legalName": {
            "type": "string",
            "minLength": 1
          },
          "taxId": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "DecaRequest": {
        "type": "object",
        "required": [
          "externalReference",
          "contractualShipper",
          "effectiveCarrier",
          "route",
          "goods",
          "transport"
        ],
        "properties": {
          "externalReference": {
            "type": "string",
            "minLength": 1
          },
          "contractualShipper": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Party"
              },
              {
                "required": [
                  "address"
                ]
              }
            ]
          },
          "effectiveCarrier": {
            "$ref": "#/components/schemas/Party"
          },
          "route": {
            "type": "object",
            "required": [
              "origin",
              "destination"
            ],
            "properties": {
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "destination": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "goods": {
            "type": "object",
            "required": [
              "nature"
            ],
            "properties": {
              "nature": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "$ref": "#/components/schemas/Measure"
              },
              "alternativeMeasure": {
                "$ref": "#/components/schemas/Measure"
              }
            }
          },
          "transport": {
            "type": "object",
            "required": [
              "date",
              "vehicle"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "vehicle": {
                "type": "object",
                "required": [
                  "tractorRegistration"
                ],
                "properties": {
                  "tractorRegistration": {
                    "type": "string",
                    "minLength": 1
                  },
                  "trailerRegistration": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "specialTrafficAuthorization": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "observations": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Measure": {
        "type": "object",
        "required": [
          "value",
          "unit"
        ],
        "properties": {
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
