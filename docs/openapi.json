    "/v1/shipments/{shipmentId}/ecmr/versions": {
      "get": {
        "operationId": "listShipmentEcmrVersions",
        "summary": "List the immutable eCMR version history for a shipment",
        "description": "Requires regulatory:read. The stored chain is integrity-verified before it is returned.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ShipmentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Verified eCMR version history and current head"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "regulatory:read scope missing"
          },
          "404": {
            "description": "Shipment not found"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          },
          "500": {
            "description": "Stored eCMR history failed integrity verification"
          }
        }
      },
      "post": {
        "operationId": "appendShipmentEcmrVersion",
        "summary": "Append an immutable eCMR version",
        "description": "Requires regulatory:write. Actor identity and timestamp are derived by the server. expectedPreviousVersionId must match the accepted head; use null for the original version.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ShipmentId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "xml",
                  "reason",
                  "partyRole",
                  "expectedPreviousVersionId"
                ],
                "properties": {
                  "xml": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 950000,
                    "description": "Exact eCMR XML string. Whitespace is preserved and contributes to integrity hashes."
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "partyRole": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "expectedPreviousVersionId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "description": "Current accepted eCMR head versionId, or null when creating version 1."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable eCMR version appended"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "regulatory:write scope missing"
          },
          "404": {
            "description": "Shipment not found"
          },
          "409": {
            "description": "Stale head, no-op amendment or concurrent lineage conflict"
          },
          "422": {
            "description": "Invalid amendment request"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    },
    "/v1/shipments/{shipmentId}/ecmr/preview": {
      "post": {
        "operationId": "previewShipmentEcmrDraft",
        "summary": "Validate and preview a structured eCMR draft",
        "description": "Requires regulatory:write. Reuses common Shipment facts and accepts only explicit eCMR-specific/legal facts. The generated XML remains internal and is not returned.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ShipmentId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "draft"
                ],
                "properties": {
                  "draft": {
                    "$ref": "#/components/schemas/EcmrStructuredDraft"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Article-6-complete structured preview with D25A wire metadata and content hash; no raw XML"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "regulatory:write scope missing"
          },
          "404": {
            "description": "Shipment not found"
          },
          "422": {
            "description": "Structured eCMR draft validation errors with path/code/legalBasis evidence"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    },
    "/v1/shipments/{shipmentId}/ecmr/versions/structured": {
      "post": {
        "operationId": "appendStructuredShipmentEcmrVersion",
        "summary": "Generate and append an immutable eCMR version from structured facts",
        "description": "Requires regulatory:write. The engine regenerates D25A XML internally and appends it to the immutable ledger. Raw XML is not returned.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ShipmentId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "draft",
                  "reason",
                  "partyRole",
                  "expectedPreviousVersionId"
                ],
                "properties": {
                  "draft": {
                    "$ref": "#/components/schemas/EcmrStructuredDraft"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "partyRole": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "expectedPreviousVersionId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "description": "Current accepted eCMR head versionId, or null for version 1."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable version appended; response contains safe version metadata and structured preview, never raw XML"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "regulatory:write scope missing"
          },
          "404": {
            "description": "Shipment not found"
          },
          "409": {
            "description": "Stale head, no-op amendment or concurrent lineage conflict"
          },
          "422": {
            "description": "Invalid structured draft or append request"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Puente DeCA API key"
      },
      "platformServiceSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Kairoseth-Service-Secret",
        "description": "Server-to-server secret accepted only from Kairoseth Platform."
      },
      "platformOrganizationId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Kairoseth-Organization-Id",
        "description": "Canonical Kairoseth organization ID paired with platform service authentication."
      }
    },
    "parameters": {
      "ShipmentId": {
        "name": "shipmentId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "DocumentId": {
        "name": "documentId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string",
            "const": "puente-deca"
          }
        }
      },
      "Party": {
        "type": "object",
        "required": [
          "legalName",
          "taxId"
        ],
        "properties": {
          "legalName": {
            "type": "string",
            "minLength": 1
          },
          "taxId": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "DecaRequest": {
        "type": "object",
        "required": [
          "externalReference",
          "contractualShipper",
          "effectiveCarrier",
          "route",
          "goods",
          "transport"
        ],
        "properties": {
          "externalReference": {
            "type": "string",
            "minLength": 1
          },
          "contractualShipper": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Party"
              },
              {
                "required": [
                  "address"
                ]
              }
            ]
          },
          "effectiveCarrier": {
            "$ref": "#/components/schemas/Party"
          },
          "route": {
            "type": "object",
            "required": [
              "origin",
              "destination"
            ],
            "properties": {
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "destination": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "goods": {
            "type": "object",
            "required": [
              "nature"
            ],
            "properties": {
              "nature": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "$ref": "#/components/schemas/Measure"
              },
              "alternativeMeasure": {
                "$ref": "#/components/schemas/Measure"
              }
            }
          },
          "transport": {
            "type": "object",
            "required": [
              "date",
              "vehicle"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "vehicle": {
                "type": "object",
                "required": [
                  "tractorRegistration"
                ],
                "properties": {
                  "tractorRegistration": {
                    "type": "string",
                    "minLength": 1
                  },
                  "trailerRegistration": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "specialTrafficAuthorization": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "observations": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Measure": {
        "type": "object",
        "required": [
          "value",
          "unit"
        ],
        "properties": {
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "EcmrPartyInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "legalName",
          "address"
        ],
        "properties": {
          "legalName": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "EcmrStructuredDraft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sender",
          "contractualCarrier",
          "consignee",
          "issue",
          "takingOver",
          "delivery",
          "goods",
          "charges",
          "customsFormalities",
          "conventionApplicability"
        ],
        "properties": {
          "sender": {
            "$ref": "#/components/schemas/EcmrPartyInput"
          },
          "contractualCarrier": {
            "$ref": "#/components/schemas/EcmrPartyInput"
          },
          "consignee": {
            "$ref": "#/components/schemas/EcmrPartyInput"
          },
          "issue": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "place"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "place": {
                "type": "string"
              }
            }
          },
          "takingOver": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "place"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "place": {
                "type": "string"
              }
            }
          },
          "delivery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "place"
            ],
            "properties": {
              "place": {
                "type": "string"
              }
            }
          },
          "goods": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "packingMethod",
              "packages",
              "dangerousGoods"
            ],
            "properties": {
              "packingMethod": {
                "type": "string"
              },
              "packingMethodCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "dangerousGoodsDescription": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "packages": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "count",
                  "marksAndNumbers"
                ],
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "marksAndNumbers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "dangerousGoods": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "declared"
                ],
                "properties": {
                  "declared": {
                    "type": "boolean"
                  },
                  "undgIdentificationCode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "regulationCode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "technicalName": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "properShippingName": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "packagingDangerLevelCode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "hazardClassificationId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "charges": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "declared",
              "items"
            ],
            "properties": {
              "declared": {
                "type": "boolean"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "chargeCategoryCode": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "amount": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "value",
                        "currency"
                      ],
                      "properties": {
                        "value": {
                          "type": "number",
                          "minimum": 0
                        },
                        "currency": {
                          "type": "string",
                          "pattern": "^[A-Z]{3}$"
                        }
                      }
                    },
                    "payingPartyRoleCode": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "transportPaymentMethodCode": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "customsFormalities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "declared",
              "instructions"
            ],
            "properties": {
              "declared": {
                "type": "boolean"
              },
              "instructions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "conventionApplicability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "declared",
              "statement"
            ],
            "properties": {
              "declared": {
                "type": "boolean"
              },
              "statement": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
