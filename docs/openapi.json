            "description": "Stored DeCA document version"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Scope missing"
          },
          "404": {
            "description": "Shipment not found"
          },
          "422": {
            "description": "Document generation rejected"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    },
    "/v1/deca/{documentId}": {
      "get": {
        "operationId": "getDecaMetadata",
        "summary": "Get stored DeCA metadata",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DocumentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Stored document metadata"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Scope missing"
          },
          "404": {
            "description": "Document not found"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    },
    "/d/{token}.pdf": {
      "get": {
        "operationId": "downloadInspectionPdf",
        "summary": "Direct QR/inspection PDF download without login",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored native DeCA PDF",
            "headers": {
              "X-DeCA-Document-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "X-DeCA-Version": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "contentEncoding": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Document not found"
          },
          "500": {
            "description": "Stored artifact integrity failure"
          }
        }
      }
    },
    "/v1/credentials": {
      "get": {
        "operationId": "listConnectorCredentials",
        "summary": "List organization-scoped connector credentials",
        "security": [
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "responses": {
          "200": {
            "description": "Credential metadata list; secrets are never returned"
          },
          "401": {
            "description": "Kairoseth service authentication required"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      },
      "post": {
        "operationId": "createConnectorCredential",
        "summary": "Create an organization-scoped connector credential",
        "security": [
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "woocommerce",
                      "prestashop",
                      "api"
                    ],
                    "default": "api",
                    "description": "Commercial connector category. Omitted legacy credentials default to api."
                  },
                  "scopes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "shipments:read",
                        "shipments:write",
                        "documents:read",
                        "documents:write",
                        "regulatory:read",
                        "regulatory:write"
                      ]
                    }
                  },
                  "expiresAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "description": "Optional commercial expiry applied to the connector credential."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Credential created; apiKey is revealed once"
          },
          "401": {
            "description": "Kairoseth service authentication required"
          },
          "403": {
            "description": "Organization connector access is inactive"
          },
          "422": {
            "description": "Invalid name, kind, scope, or credential expiry"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      },
      "patch": {
        "operationId": "synchronizeConnectorCredentialExpiry",
        "summary": "Set the expiry timestamp on all active organization connector credentials",
        "security": [
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expiresAt"
                ],
                "properties": {
                  "expiresAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Active connector credential expiry synchronized"
          },
          "401": {
            "description": "Kairoseth service authentication required"
          },
          "422": {
            "description": "Invalid expiry timestamp"
          },
          "429": {
            "description": "Authenticated subject exceeded the per-process request limit"
          }
        }
      }
    },
    "/v1/credentials/{credentialId}": {
      "delete": {
        "operationId": "revokeConnectorCredential",
        "summary": "Revoke an organization-scoped connector credential",
        "security": [
          {
            "platformServiceSecret": [],
            "platformOrganizationId": []
          }
        ],
        "parameters": [
          {
            "name": "credentialId",
            "in": "path",
