# Production target after Kairoseth reverse-proxy acceptance:
# PUBLIC_BASE_URL=https://kairoseth.com/deca
PORT=8080
PUBLIC_BASE_URL=https://deca.example.com
# Development/test metadata persistence.
PERSISTENCE_DRIVER=json
STORE_PATH=.data/store.json

# Production metadata persistence: same MongoDB Atlas stack as Kairoseth Platform.
# PERSISTENCE_DRIVER can be omitted when MONGODB_URI is present.
MONGODB_URI=
MONGODB_DB_NAME=kairoseth
# Emergency diagnostics only; do not enable in normal production.
ALLOW_JSON_STORE_IN_PRODUCTION=0

ARTIFACT_DIR=.data/documents

# Server-to-server only. Use a high-entropy secret of at least 32 characters.
KAIROSETH_SERVICE_SECRET=
