{
  "name": "puente-deca",
  "version": "0.1.0",
  "private": true,
  "description": "API-first bridge for Spain DeCA transport compliance",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "node scripts/ci/repo-check.mjs && node scripts/ci/openapi-check.mjs && node scripts/ci/woocommerce-check.mjs",
    "test": "node --test",
    "server": "node apps/api/src/main.mjs",
    "file-import:demo": "node connectors/file-import/src/cli.mjs examples/file-import/shipments.csv",
    "file-import:xlsx:demo": "node connectors/file-import/src/cli.mjs examples/file-import/shipments.xlsx",
    "contract:reference": "node packages/connector-contract-suite/src/cli.mjs connectors/reference/contract.mjs examples/connectors/reference.json",
    "contract:file-import": "node packages/connector-contract-suite/src/cli.mjs connectors/file-import/contract.mjs examples/connectors/file-import.json",
    "contract:woocommerce": "node packages/connector-contract-suite/src/cli.mjs connectors/woocommerce/contract.mjs examples/connectors/woocommerce.json"
  },
  "dependencies": {
    "read-excel-file": "9.3.10"
  }
}
