{
  "name": "puente-deca",
  "version": "0.1.0",
  "private": true,
  "description": "API-first bridge for Spain DeCA transport compliance",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "node scripts/ci/repo-check.mjs && node scripts/ci/openapi-check.mjs && node scripts/ci/woocommerce-check.mjs && node scripts/ci/prestashop-check.mjs && node scripts/ci/mongodb-check.mjs && node scripts/ci/artifact-storage-check.mjs && node scripts/ci/shared-mongo-client-check.mjs && node scripts/ci/retention-check.mjs",
    "test": "node --test",
    "server": "node apps/api/src/main.mjs",
    "file-import:demo": "node connectors/file-import/src/cli.mjs examples/file-import/shipments.csv",
    "file-import:xlsx:demo": "node connectors/file-import/src/cli.mjs examples/file-import/shipments.xlsx",
    "contract:reference": "node packages/connector-contract-suite/src/cli.mjs connectors/reference/contract.mjs examples/connectors/reference.json",
    "contract:file-import": "node packages/connector-contract-suite/src/cli.mjs connectors/file-import/contract.mjs examples/connectors/file-import.json",
    "contract:woocommerce": "node packages/connector-contract-suite/src/cli.mjs connectors/woocommerce/contract.mjs examples/connectors/woocommerce.json",
    "contract:prestashop": "node packages/connector-contract-suite/src/cli.mjs connectors/prestashop/contract.mjs examples/connectors/prestashop.json",
    "check:mongodb": "node scripts/ci/mongodb-check.mjs",
    "check:artifacts": "node scripts/ci/artifact-storage-check.mjs",
    "check:shared-mongo": "node scripts/ci/shared-mongo-client-check.mjs",
    "check:retention": "node scripts/ci/retention-check.mjs",
    "retention:inspect": "node scripts/retention/retention-cli.mjs inspect",
    "retention:purge": "node scripts/retention/retention-cli.mjs purge",
    "artifacts:reconcile": "node scripts/retention/retention-cli.mjs reconcile"
  },
  "dependencies": {
    "read-excel-file": "9.3.10",
    "mongodb": "7.5.0"
  }
}
